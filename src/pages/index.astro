---
import "../styles/global.css";
import { DEMO_MENU, DEMO_KEYWORDS } from "../fixtures/demo";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>nav-sense · la nav es una decisión de lenguaje</title>
    <link rel="icon" type="image/svg+xml" href="/nova-mark.svg" />
    <meta
      name="description"
      content="Pegá tu menú y tus keywords. nav-sense te muestra el gap entre cómo está armada la navegación y cómo la gente busca."
    />
  </head>
  <body>
    <div class="wrap">
      <header class="hero">
        <img src="/nova-mark.png" width="110" alt="Nova" />
        <h1>nav-sense</h1>
        <p class="tagline">La navegación es una decisión de lenguaje, no de gusto.</p>
        <p class="sub">
          Pegá la estructura de tu menú y las keywords que te importan. Te muestro el gap entre cómo
          está armada la nav y cómo la gente realmente busca. Todo corre en tu navegador, no se manda
          nada a ningún lado.
        </p>
      </header>

      <div class="grid">
        <section class="panel">
          <h2>Menú / Arquitectura</h2>
          <label class="field" for="menu">Texto indentado o JSON [&#123; label, children &#125;]</label>
          <textarea id="menu" spellcheck="false">{DEMO_MENU}</textarea>
        </section>
        <section class="panel">
          <h2>Keywords / Entidades</h2>
          <label class="field" for="keywords">Una por línea. Volumen opcional: término | 1200</label>
          <textarea id="keywords" spellcheck="false">{DEMO_KEYWORDS}</textarea>
        </section>
      </div>

      <div class="actions">
        <button id="analyze">Analizar gap</button>
        <button id="demo" class="ghost">Cargar demo</button>
        <span class="coverage hidden" id="coverage"></span>
      </div>

      <section class="panel thresholds">
        <h2>Umbrales de match</h2>
        <p class="sub" style="margin: 0 0 0.8rem; text-align: left">
          Cuánto parecido es parecido no tiene verdad absoluta. Lo decidís vos. Movelos y el reporte
          se recalcula solo.
        </p>
        <div class="slider-row">
          <label for="strong">Match fuerte (cubre la demanda)</label>
          <input type="range" id="strong" min="0.3" max="0.95" step="0.05" value="0.6" />
          <output id="strong-val">0.60</output>
        </div>
        <div class="slider-row">
          <label for="weak">Match debil (apenas roza)</label>
          <input type="range" id="weak" min="0.05" max="0.6" step="0.05" value="0.3" />
          <output id="weak-val">0.30</output>
        </div>
        <button id="reset" class="ghost" style="margin-top: 0.4rem">Volver a los defaults (0.60 / 0.30)</button>
      </section>

      <div id="error" class="error hidden"></div>

      <div id="results" class="results hidden">
        <h2>Gap report</h2>
        <table id="gap-table">
          <thead>
            <tr>
              <th>Tipo</th>
              <th>Que</th>
              <th>Vol.</th>
              <th>Diagnostico</th>
              <th>Sugerencia</th>
            </tr>
          </thead>
          <tbody id="gap-body"></tbody>
        </table>

        <h2>Propuesta de IA reordenada</h2>
        <pre class="changelog" id="proposed"></pre>

        <h2>Changelog markdown</h2>
        <div class="actions" style="margin: 0 0 0.6rem">
          <button id="copy" class="ghost">Copiar changelog</button>
        </div>
        <pre class="changelog" id="changelog"></pre>
      </div>

      <footer>
        nav-sense · suite open-source de <a href="https://github.com/rodrigoscz">@rodrigoscz</a> ·
        todo es lenguaje
      </footer>
    </div>

    <script>
      import { analyze } from "../lib/analyze";
      import { buildProposal, treeToText } from "../lib/changelog";
      import { DEMO_MENU, DEMO_KEYWORDS } from "../fixtures/demo";

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const menuEl = $<HTMLTextAreaElement>("menu");
      const kwEl = $<HTMLTextAreaElement>("keywords");
      const errEl = $<HTMLDivElement>("error");
      const resultsEl = $<HTMLDivElement>("results");
      const bodyEl = $<HTMLTableSectionElement>("gap-body");
      const coverageEl = $<HTMLSpanElement>("coverage");
      const proposedEl = $<HTMLPreElement>("proposed");
      const changelogEl = $<HTMLPreElement>("changelog");
      const strongEl = $<HTMLInputElement>("strong");
      const weakEl = $<HTMLInputElement>("weak");
      const strongValEl = $<HTMLOutputElement>("strong-val");
      const weakValEl = $<HTMLOutputElement>("weak-val");

      const LABELS: Record<string, string> = {
        "missing-demand": "demanda sin label",
        "ghost-label": "label sin demanda",
        "ambiguous-label": "label ambiguo",
        "misnested-label": "mal anidado",
      };

      function esc(s: string): string {
        const d = document.createElement("div");
        d.textContent = s;
        return d.innerHTML;
      }

      function readThresholds() {
        let strong = Number(strongEl.value);
        let weak = Number(weakEl.value);
        // Keep the dials coherent: weak can never sit above strong.
        if (weak > strong) weak = strong;
        strongValEl.textContent = strong.toFixed(2);
        weakValEl.textContent = weak.toFixed(2);
        return { strong, weak };
      }

      function run() {
        errEl.classList.add("hidden");
        try {
          const thresholds = readThresholds();
          const analysis = analyze({ menuText: menuEl.value, keywordText: kwEl.value, thresholds });
          const { tree, changelog } = buildProposal(analysis);

          bodyEl.innerHTML = "";
          if (analysis.findings.length === 0) {
            bodyEl.innerHTML =
              '<tr><td colspan="5" class="empty">Sin gaps. La nav ya habla el idioma de la demanda.</td></tr>';
          }
          for (const f of analysis.findings) {
            const what = f.label ?? f.keyword ?? "";
            const vol = f.volume && f.volume > 0 ? String(f.volume) : "·";
            const tr = document.createElement("tr");
            tr.innerHTML =
              `<td><span class="tag ${f.kind}">${LABELS[f.kind]}</span></td>` +
              `<td>${esc(what)}</td>` +
              `<td>${vol}</td>` +
              `<td>${esc(f.detail)}</td>` +
              `<td class="suggestion">${esc(f.suggestion)}</td>`;
            bodyEl.appendChild(tr);
          }

          const pct = Math.round(analysis.demandCoverage * 100);
          coverageEl.innerHTML = `cobertura de demanda: <strong>${pct}%</strong>`;
          coverageEl.classList.remove("hidden");

          proposedEl.textContent = treeToText(tree);
          changelogEl.textContent = changelog;
          resultsEl.classList.remove("hidden");
        } catch (e) {
          resultsEl.classList.add("hidden");
          coverageEl.classList.add("hidden");
          errEl.textContent = e instanceof Error ? e.message : "Algo salio mal al analizar.";
          errEl.classList.remove("hidden");
        }
      }

      $<HTMLButtonElement>("analyze").addEventListener("click", run);
      $<HTMLButtonElement>("demo").addEventListener("click", () => {
        menuEl.value = DEMO_MENU;
        kwEl.value = DEMO_KEYWORDS;
        run();
      });
      $<HTMLButtonElement>("copy").addEventListener("click", async () => {
        await navigator.clipboard.writeText(changelogEl.textContent ?? "");
      });

      // Live recalc: every slider nudge re-runs the analysis. The number is the
      // user's, so the report follows the dial in real time.
      strongEl.addEventListener("input", () => {
        // Clamp the weak dial's ceiling to the new strong value.
        if (Number(weakEl.value) > Number(strongEl.value)) weakEl.value = strongEl.value;
        run();
      });
      weakEl.addEventListener("input", () => {
        if (Number(weakEl.value) > Number(strongEl.value)) weakEl.value = strongEl.value;
        run();
      });
      $<HTMLButtonElement>("reset").addEventListener("click", () => {
        strongEl.value = "0.6";
        weakEl.value = "0.3";
        run();
      });

      run();
    </script>
  </body>
</html>
